+        else if(*reserve>='a' && *reserve<='f') digit = *reserve - 'a' + 10;
+        else if(*reserve=='-') {
+            if(!first) {
+                printf_log(LOG_INFO, "Warning, Wine prereserve badly formatted\n");
+                return 0;
+            }
+            start = r & ~wine_granularity_mask;
