 static int get_prereserve(const char* reserve, void** addr, size_t* size)
 {
     if(!reserve)
         return 0;
     uintptr_t r = 0;
+    uintptr_t start = 0;
+    const uintptr_t wine_granularity_mask = 0xffff;
     int first = 1;
